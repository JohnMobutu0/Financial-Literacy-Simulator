<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <!-- Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="FINANCIAL LITERACY"
            android:textColor="#C69A45"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Create your account"
            android:textColor="#142D4E"
            android:textSize="29sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Join us and start building your financial knowledge."
            android:textColor="#737F91"
            android:textSize="14sp"/>

        <!-- Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="Full name"
            android:textColor="#142D4E"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/registerName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_investment_card"
            android:padding="16dp"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:textColor="#142D4E"
            android:textColorHint="#A0A8B5"/>

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email address"
            android:textColor="#142D4E"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/registerEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_investment_card"
            android:padding="16dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:textColor="#142D4E"
            android:textColorHint="#A0A8B5"/>

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Password"
            android:textColor="#142D4E"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/registerPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_investment_card"
            android:padding="16dp"
            android:hint="Create a password"
            android:inputType="textPassword"
            android:textColor="#142D4E"
            android:textColorHint="#A0A8B5"/>

        <!-- Confirm Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Confirm password"
            android:textColor="#142D4E"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/confirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_investment_card"
            android:padding="16dp"
            android:hint="Confirm your password"
            android:inputType="textPassword"
            android:textColor="#142D4E"
            android:textColorHint="#A0A8B5"/>

        <!-- Register Button -->
        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:text="CREATE ACCOUNT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#142D4E"/>

        <!-- Login Link -->
        <TextView
            android:id="@+id/goToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Already have an account? Sign in"
            android:textColor="#C69A45"
            android:textStyle="bold"
            android:textSize="14sp"/>

    </LinearLayout>

</ScrollView>
