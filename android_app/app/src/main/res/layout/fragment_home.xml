<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINANCIAL LITERACY"
            android:textColor="#C69A45"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Welcome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Build your financial future."
            android:textColor="#142D4E"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Understand your options. Make informed investment decisions."
            android:textColor="#737F91"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Portfolio Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_portfolio_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR LEARNING PORTFOLIO"
                android:textColor="#D8E2EF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="KSh 0.00"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Explore simulated investment opportunities"
                android:textColor="#D8E2EF"
                android:textSize="13sp" />

            <View
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="20dp"
                android:background="#D9AD59" />

        </LinearLayout>

        <!-- Learning Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Explore investments"
            android:textColor="#142D4E"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose a category and discover how it works."
            android:textColor="#737F91"
            android:textSize="13sp" />

        <!-- Treasury Bonds Card -->
        <LinearLayout
            android:id="@+id/treasuryBondsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_investment_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01  |  TREASURY BONDS"
                android:textColor="#C69A45"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Lend. Earn. Grow."
                android:textColor="#142D4E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Discover how lending money to the government can generate interest."
                android:textColor="#737F91"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Money Market Funds -->
        <LinearLayout
            android:id="@+id/mmfCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02  |  MONEY MARKET FUNDS"
                android:textColor="#C69A45"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Make your savings work."
                android:textColor="#142D4E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Explore professionally managed short-term investments."
                android:textColor="#737F91"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- SACCO -->
        <LinearLayout
            android:id="@+id/saccoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03  |  SACCO SHARES"
                android:textColor="#C69A45"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Grow together."
                android:textColor="#142D4E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Understand cooperative membership and share ownership."
                android:textColor="#737F91"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- NSE Stocks -->
        <LinearLayout
            android:id="@+id/stocksCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04  |  NSE STOCKS"
                android:textColor="#C69A45"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Own a piece of a company."
                android:textColor="#142D4E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Learn how buying and selling company shares works."
                android:textColor="#737F91"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Fixed Deposits -->
        <LinearLayout
            android:id="@+id/fixedDepositsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05  |  FIXED DEPOSITS"
                android:textColor="#C69A45"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Save with a purpose."
                android:textColor="#142D4E"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Discover how fixed-term bank deposits earn interest."
                android:textColor="#737F91"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Scam Awareness -->
        <LinearLayout
            android:id="@+id/scamAwarenessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="#FFF5E8"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06  |  SCAM AWARENESS"
                android:textColor="#A76519"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Protect your money."
                android:textColor="#704313"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Identify suspicious offers and learn how to avoid investment scams."
                android:textColor="#805F39"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="Learn today. Invest wisely tomorrow."
            android:textColor="#8A94A4"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
