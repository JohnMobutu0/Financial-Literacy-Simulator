<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMmfDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/design_default_color_primary"
        app:title="Invest in MMF"
        app:titleTextColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvMmfDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CIC MMF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/tvMmfDetailYield"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Projected Yield: 12% p.a."
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount to Invest (KES)"
            android:textSize="14sp"
            android:textColor="#757575"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMmfAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="e.g. 5000" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnInvestMmf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Investment"
            android:layout_marginTop="24dp"
            app:cornerRadius="8dp"/>

        <TextView
            android:id="@+id/tvMmfError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/holo_red_dark"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>